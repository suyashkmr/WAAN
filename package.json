{
  "name": "waan-suite",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "WAAN macOS distribution containing the offline ChatScope analytics dashboard.",
  "workspaces": [
    "apps/server"
  ],
  "scripts": {
    "bootstrap": "npm install --workspaces",
    "build:prime-theme-bridge": "node scripts/generate-prime-theme-bridge.mjs",
    "tailwind:build": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -c tailwind.config.cjs -i styles.tailwind.src.css -o styles.tailwind.css --minify",
    "tailwind:watch": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -c tailwind.config.cjs -i styles.tailwind.src.css -o styles.tailwind.css --watch",
    "check:tailwind-layout-only": "node scripts/check-tailwind-layout-only.mjs",
    "check:tailwind-size": "node scripts/check-tailwind-size.mjs",
    "lint": "eslint js apps/server/src",
    "check:unused-exports": "eslint js apps/server/src tests",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "check:circular": "madge --extensions js --circular js apps/server/src",
    "check:artifacts": "bash scripts/check-artifacts.sh",
    "check:prime-theme-bridge": "node scripts/generate-prime-theme-bridge.mjs --check",
    "check:module-size": "node scripts/check-module-size.mjs",
    "check:legacy-primitives": "node scripts/check-legacy-primitive-imports.mjs",
    "check:types": "tsc --noEmit",
    "check:appshell-contracts": "vitest --run tests/appShellBoot.test.js tests/appShellBoundaryIntegration.test.js tests/controllerWiringContracts.test.js tests/compositionAssemblyContracts.test.js tests/appShellAssemblyWiring.test.js",
    "check:release-reliability": "vitest --run tests/releaseRelayTransitions.test.js tests/releaseExportIntegrity.test.js",
    "check:coverage": "vitest --run --coverage --retry=2",
    "test:smoke": "npm run check:appshell-contracts",
    "test": "vitest --run",
    "test:visual": "PW_VISUAL_PORT=4174 PW_VISUAL_DIST_DIR=dist playwright test",
    "test:visual:shard:desktop": "VISUAL_SHARD=desktop PW_VISUAL_PORT=4174 PW_VISUAL_DIST_DIR=dist-desktop playwright test --project=desktop-1440 --project=laptop-1024",
    "test:visual:shard:mobile": "VISUAL_SHARD=mobile PW_VISUAL_PORT=4175 PW_VISUAL_DIST_DIR=dist-mobile playwright test --project=tablet-768 --project=mobile-390",
    "test:visual:sharded": "npm run test:visual:shard:desktop && npm run test:visual:shard:mobile",
    "test:visual:ci": "sh -c 'if [ \"${VISUAL_SHARD:-desktop}\" = \"mobile\" ]; then npm run test:visual:shard:mobile; else npm run test:visual:shard:desktop; fi'",
    "test:visual:ui": "PW_VISUAL_PORT=4174 PW_VISUAL_DIST_DIR=dist playwright test --ui",
    "test:accessibility-smoke": "PW_VISUAL_PORT=4174 PW_VISUAL_DIST_DIR=dist playwright test tests/visual/accessibility.smoke.spec.js",
    "test:visual:update": "PW_VISUAL_PORT=4174 PW_VISUAL_DIST_DIR=dist playwright test --update-snapshots",
    "perf:stress": "node scripts/stress-large-chat.mjs",
    "perf:chatstore": "node scripts/measure-chatstore-write-amplification.mjs",
    "perf:searchworker": "node scripts/measure-search-worker-index.mjs",
    "check:perf-budgets": "node scripts/check-perf-budgets.mjs",
    "release:cut": "node scripts/cut-release.cjs",
    "check:release-notes": "node scripts/validate-release-notes.mjs",
    "verify": "npm run lint && npm test",
    "ci:verify": "npm run check:artifacts && npm run check:module-size && npm run check:legacy-primitives && npm run check:unused-exports && npm run check:types && npm run check:dead-code && npm run tailwind:build && npm run check:tailwind-size && npm run check:tailwind-layout-only && npm run check:appshell-contracts && npm run check:release-reliability && npm run verify && npm run check:coverage && npm run check:circular",
    "dev": "vite",
    "build": "npm run tailwind:build && vite build",
    "preview": "vite preview",
    "start": "vite"
  },
  "author": "WAAN",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "express": "^4.19.2",
    "primevue": "^4.5.4",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.0.14",
    "@vitest/coverage-v8": "^4.0.14",
    "depcheck": "1.4.7",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "madge": "8.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.14"
  }
}
