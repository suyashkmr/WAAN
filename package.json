{
  "name": "waan-suite",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "description": "WAAN macOS distribution containing the offline ChatScope analytics dashboard.",
  "workspaces": [
    "apps/server"
  ],
  "scripts": {
    "bootstrap": "npm install --workspaces",
    "tailwind:build": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -c tailwind.config.cjs -i styles.tailwind.src.css -o styles.tailwind.css --minify",
    "tailwind:watch": "BROWSERSLIST_IGNORE_OLD_DATA=1 tailwindcss -c tailwind.config.cjs -i styles.tailwind.src.css -o styles.tailwind.css --watch",
    "check:tailwind-adoption": "node scripts/check-tailwind-adoption.mjs",
    "check:tailwind-size": "node scripts/check-tailwind-size.mjs",
    "lint": "eslint js apps/server/src",
    "check:unused-exports": "eslint js apps/server/src tests",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "check:circular": "madge --extensions js --circular js apps/server/src",
    "check:artifacts": "bash scripts/check-artifacts.sh",
    "check:vendor-runtime": "node scripts/check-vendor-runtime.mjs",
    "check:module-size": "node scripts/check-module-size.mjs",
    "check:types": "tsc --noEmit",
    "check:appshell-contracts": "vitest --run tests/appShellBoot.test.js tests/appShellBoundaryIntegration.test.js tests/controllerWiringContracts.test.js tests/compositionAssemblyContracts.test.js tests/appShellAssemblyWiring.test.js",
    "check:release-reliability": "vitest --run tests/releaseRelayTransitions.test.js tests/releaseExportIntegrity.test.js",
    "test:smoke": "npm run check:appshell-contracts",
    "test": "vitest --run",
    "test:visual": "playwright test",
    "test:accessibility-smoke": "playwright test tests/visual/accessibility.smoke.spec.js",
    "test:visual:update": "playwright test --update-snapshots",
    "perf:stress": "node scripts/stress-large-chat.mjs",
    "perf:chatstore": "node scripts/measure-chatstore-write-amplification.mjs",
    "perf:searchworker": "node scripts/measure-search-worker-index.mjs",
    "check:perf-budgets": "node scripts/check-perf-budgets.mjs",
    "release:cut": "node scripts/cut-release.cjs",
    "check:release-notes": "node scripts/validate-release-notes.mjs",
    "verify": "npm run lint && npm test",
    "ci:verify": "npm run check:artifacts && npm run check:vendor-runtime && npm run check:module-size && npm run check:unused-exports && npm run check:types && npm run check:dead-code && npm run tailwind:build && npm run check:tailwind-size && npm run check:tailwind-adoption && npm run check:appshell-contracts && npm run check:release-reliability && npm run verify && npm run check:circular",
    "coverage": "vitest --run --coverage",
    "start": "node serve.js"
  },
  "author": "WAAN",
  "license": "MIT",
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "express": "^4.19.2",
    "primevue": "^4.5.4",
    "vue": "^3.5.29"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@vitest/coverage-v8": "^4.0.14",
    "depcheck": "1.4.7",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.0.11",
    "madge": "8.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
