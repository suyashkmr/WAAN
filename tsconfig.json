{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "js/**/*.js",
    "apps/server/src/**/*.js",
    "scripts/**/*.js",
    "tests/**/*.js",
    "*.js"
  ],
  "exclude": [
    "node_modules",
    "electron/dist",
    "playwright-report",
    "test-results"
  ]
}
